{
  "name": "Finanzas",
  "short_name": "Finanzas",
  "description": "Tarjetas, sobres, tasa cero y préstamo de casa en ₡ y $",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121417",
  "theme_color": "#121417",
  "icons": [
    {
      "src": "icons/icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icono-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".png",
            ".jpg",
            ".jpeg"
          ]
        }
      ]
    }
  }
}
